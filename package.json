{
  "name": "bluecode",
  "version": "0.0.1",
  "description": "BlueCode — context engineering for opencode: hot-path tool-output compression (rtk) plus a long-session history-compaction daemon (headroomd), mounted as one plugin",
  "keywords": [
    "coding-agent",
    "context-engineering",
    "opencode",
    "token-compression",
    "llm"
  ],
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "eval": "bun run --cwd packages/eval src/cli.ts",
    "verify": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "bun-types": "^1.4.0",
    "typescript": "^5.7.0"
  }
}
