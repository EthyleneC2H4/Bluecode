{
  "name": "bluecode",
  "version": "0.0.1",
  "description": "BlueCode \u2014 OpenCode context engineering and optional tool safety: RTK, headroomd and VSecAgent coordinated by one plugin",
  "keywords": [
    "coding-agent",
    "context-engineering",
    "opencode",
    "token-compression",
    "llm"
  ],
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "eval": "bun run --cwd packages/eval src/cli.ts",
    "check:deps": "bun scripts/check-dependency-direction.ts",
    "verify": "bun run typecheck && bun test && bun run check:deps && bun run check:host && bun run check:security",
    "migrate": "bun scripts/migrate-storage.ts",
    "check:host": "bun scripts/check-host-imports.ts",
    "gc": "bun scripts/gc-storage.ts",
    "eval:headroom": "bun packages/eval/src/headroom-cli.ts",
    "eval:retention": "bun scripts/eval-headroom-retention.ts",
    "eval:live": "bun packages/eval/src/live-cli.ts",
    "eval:security": "bun packages/eval/src/security-cli.ts",
    "eval:security:host": "bun packages/eval/src/security-host.ts",
    "check:security": "bun scripts/check-security.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "bun-types": "1.4.0",
    "typescript": "5.9.3"
  }
}
